{
  "name": "konpuk-server",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node -e \"console.log('Server build gate passed (runtime JavaScript service)')\"",
    "typecheck": "node -e \"const fs=require('fs');JSON.parse(fs.readFileSync('tsconfig.json','utf8'));console.log('tsconfig valid');\"",
    "lint": "eslint \"**/*.js\" --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern uploads",
    "lint:fix": "eslint \"**/*.js\" --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern uploads --fix",
    "make:admin": "node scripts/make-admin.js",
    "seed:dev": "node scripts/seed-dev-accounts.js",
    "repair:text-index": "node scripts/repair-product-text-index.js",
    "fix:email-index": "node scripts/fix-email-index.js",
    "backfill:sellers": "node scripts/backfill-product-sellers.js",
    "cleanup:test-sellers": "node scripts/cleanup-test-sellers.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:unit": "node --test ./__tests__/auth.service.test.js",
    "test:seller": "node scripts/run-seller-verification-tests.js",
    "ci": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.38.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.7.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "axios": "^1.4.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "mongodb-memory-server": "^8.12.1",
    "nodemon": "^3.0.1"
  ,
    "typescript": "^5.5.0"
  }
}
